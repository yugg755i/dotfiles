{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,

    "modules-left": [
        "group/ws-pill",
        "custom/lyrics"
    ],

    "modules-center": [
        "group/clock-pill"
    ],

    "modules-right": [
        "group/system-pill",
        "group/power-pill"
    ],


    // =========================================================
    // WORKSPACE
    // =========================================================

    "group/ws-pill": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/workspaces"
        ]
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },


    // =========================================================
    // CLOCK
    // =========================================================

    "group/clock-pill": {
        "orientation": "horizontal",
        "modules": [
            "custom/clock"
        ]
    },

    "custom/clock": {
        "exec": "date +'%I:%M %p %A, %b %d' | awk '{print tolower($0)}'",
        "interval": 3,
        "format": "{}"
    },


    // =========================================================
    // LYRICS
    // =========================================================

    "custom/lyrics": {
        "exec": "~/.config/waybar/scripts/waybar-lyrics.sh",
        "interval": 1,
        "on-click": "swaync-client -t",
        "on-click-right": "bash ~/.config/waybar/scripts/toggle-lyrics.sh",
        "return-type": "json",
        "tooltip": true
    },


    // =========================================================
    // SYSTEM
    // =========================================================

    "group/system-pill": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "temperature",
            "backlight"
        ]
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol muted",
        "tooltip": false
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "temp {temperatureC}°C",
        "critical-threshold": 85,
        "tooltip": false
    },

    "backlight": {
        "format": "mon {percent}%",
        "tooltip": false
    },


    // =========================================================
    // POWER
    // =========================================================

    "group/power-pill": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "custom/power-mode",
            "custom/sysinfo"
        ]
    },

    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "ac: {capacity}%",
        "states": {
            "critical": 15
        },
        "tooltip": false,
        "interval": 20
    },

    "custom/power-mode": {
        "exec": "~/.config/rofi/power-mode.sh --status",
        "on-click": "bash ~/.config/rofi/power-mode.sh",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },

    "custom/sysinfo": {
        "format": "{}",
        "on-click-middle": "kitty -e btop",
        "on-click": "swaync-client -t",
        "on-click-right": "bash ~/.config/rofi/powermenu.sh",
        "exec": "~/.config/waybar/scripts/waybar-sysinfo.sh",
        "interval": 3,
        "return-type": "json"
    }
}
