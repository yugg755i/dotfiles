@theme "/dev/null"
@import "~/.config/rofi/colors.rasi"

* {
    font:               "JetBrainsMono Nerd Font 13";
    border:             0;
    margin:             0;
    padding:            0;
    spacing:            0;
    drun-match-fields: "name";
}

window {
    background-color: @surface-container;
    border:             1px solid;
    padding:            8px;
    width:              400px;
    location:           center;
    fixed-height:       false;
}

mainbox {
    background-color:   transparent;
    spacing:            6px;
    padding:            0;
    children:           [ inputbar, listview];
}

inputbar {
    background-color:   transparent;
    border:             2px solid;
    padding:            12px 16px;
    spacing:            8px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @primary;
    font:               "JetBrainsMono Nerd Font Bold 13";
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @on-surface;
    placeholder:        "Search";
    placeholder-color:  @on-surface;
    vertical-align:     0.5;
    expand:             true;
}

listview {
    background-color:   transparent;
    spacing:            2px;
    padding:            4px 0 0 0;
    lines:              5;
    cycle:              false;
    dynamic:            true;
    scrollbar:          false;
    fixed-height:       false;
}
element {
    background-color:   transparent;
    padding:            11px 16px;
    spacing:            12px;
    orientation:        horizontal;
    children:           [ element-text ];
}

element normal.normal {
    background-color:   transparent;
    text-color:         @on-surface;
}

element selected.normal {
    background-color:   @primary;
    text-color:         @on-primary;
}

element alternate.normal {
    background-color:   transparent;
    text-color:         @on-surface;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    expand:             true;
}
